generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum PromptStorageMode {
  METADATA_ONLY
  REDACTED
  FULL_LOGGING
}

enum AiRequestSource {
  SLACK
  WEB
}

enum AiRequestStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum BackgroundJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id                          String                       @id @default(cuid())
  name                        String
  slug                        String                       @unique
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  memberships                 Membership[]
  clients                     Client[]
  projects                    Project[]
  workflowTypes               WorkflowType[]
  slackWorkspaces             SlackWorkspace[]
  slackChannelMappings        SlackChannelMapping[]
  clientRevenues              ClientRevenue[]
  privacySettings             OrganizationPrivacySettings?
  aiRequestAudits             AiRequestAudit[]
  aiUsageEvents               AiUsageEvent[]
  employees                   Employee[]
  aiSourceApps                AiSourceApp[]
  modelProviderConnections    ModelProviderConnection[]
  backgroundJobs              BackgroundJob[]
  aiAttributionDecisions      AiAttributionDecision[]
  attributionTrainingExamples AttributionTrainingExample[]
  attributionModelVersions    AttributionModelVersion[]

  @@index([createdAt])
}

model AppUser {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        Membership[]
  aiRequestAudits    AiRequestAudit[]
  passwordCredential PasswordCredential?

  @@index([createdAt])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
}

model Client {
  id                   String                @id @default(cuid())
  organizationId       String
  externalId           String?
  name                 String
  externalAccountingId String?
  status               ClientStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects             Project[]
  slackChannelMappings SlackChannelMapping[]
  clientRevenues       ClientRevenue[]
  aiRequestAudits      AiRequestAudit[]
  aiUsageEvents        AiUsageEvent[]

  @@unique([organizationId, name])
  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model Project {
  id                   String                @id @default(cuid())
  organizationId       String
  clientId             String
  externalId           String?
  name                 String
  status               ProjectStatus         @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client               Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  slackChannelMappings SlackChannelMapping[]
  clientRevenues       ClientRevenue[]
  aiRequestAudits      AiRequestAudit[]
  aiUsageEvents        AiUsageEvent[]

  @@unique([organizationId, clientId, name])
  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model WorkflowType {
  id                   String                       @id @default(cuid())
  organizationId       String
  externalId           String?
  name                 String
  slug                 String
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slackChannelMappings SlackChannelMapping[]
  aiRequestAudits      AiRequestAudit[]
  aiUsageEvents        AiUsageEvent[]
  predictedDecisions   AiAttributionDecision[]      @relation("PredictedWorkflow")
  finalDecisions       AiAttributionDecision[]      @relation("FinalWorkflow")
  trainingExamples     AttributionTrainingExample[]

  @@unique([organizationId, slug])
  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([createdAt])
}

model SlackWorkspace {
  id                String                @id @default(cuid())
  organizationId    String
  slackTeamId       String                @unique
  slackTeamName     String?
  botUserId         String?
  encryptedBotToken String?
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelMappings   SlackChannelMapping[]

  @@index([organizationId])
  @@index([createdAt])
}

model SlackChannelMapping {
  id                    String         @id @default(cuid())
  organizationId        String
  slackWorkspaceId      String
  slackChannelId        String
  slackChannelName      String?
  clientId              String?
  projectId             String?
  defaultWorkflowTypeId String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slackWorkspace        SlackWorkspace @relation(fields: [slackWorkspaceId], references: [id], onDelete: Cascade)
  client                Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project               Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  defaultWorkflowType   WorkflowType?  @relation(fields: [defaultWorkflowTypeId], references: [id], onDelete: SetNull)

  @@unique([slackWorkspaceId, slackChannelId])
  @@index([organizationId])
  @@index([clientId])
  @@index([projectId])
  @@index([createdAt])
}

model ClientRevenue {
  id                    String       @id @default(cuid())
  organizationId        String
  clientId              String
  projectId             String?
  month                 String
  revenueUsd            Decimal      @db.Decimal(18, 2)
  estimatedLaborCostUsd Decimal?     @db.Decimal(18, 2)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([clientId, projectId, month])
  @@index([organizationId])
  @@index([clientId])
  @@index([projectId])
  @@index([month])
  @@index([createdAt])
}

model Employee {
  id                   String                  @id @default(cuid())
  organizationId       String
  name                 String
  email                String?
  department           String?
  role                 String?
  externalId           String?
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiRequestAudits      AiRequestAudit[]
  aiUsageEvents        AiUsageEvent[]
  attributionDecisions AiAttributionDecision[]

  @@unique([organizationId, name])
  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([organizationId, email])
  @@index([createdAt])
}

model ModelProviderConnection {
  id                  String       @id @default(cuid())
  organizationId      String
  name                String
  providerType        String
  endpointUrl         String?
  encryptedCredential String?
  allowedModels       Json
  isActive            Boolean      @default(true)
  lastValidatedAt     DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([createdAt])
}

model AiSourceApp {
  id                   String                  @id @default(cuid())
  organizationId       String
  name                 String
  type                 String
  description          String?
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiRequestAudits      AiRequestAudit[]
  aiUsageEvents        AiUsageEvent[]
  credentials          AiSourceAppCredential[]
  attributionDecisions AiAttributionDecision[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, type])
  @@index([createdAt])
}

model AiSourceAppCredential {
  id             String      @id @default(cuid())
  organizationId String
  sourceAppId    String
  name           String
  keyPrefix      String
  keyHash        String
  keyLast4       String
  isActive       Boolean     @default(true)
  scopes         Json?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sourceApp      AiSourceApp @relation(fields: [sourceAppId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sourceAppId])
  @@index([keyPrefix])
  @@index([organizationId, sourceAppId])
  @@index([createdAt])
}

model OrganizationPrivacySettings {
  id                                  String            @id @default(cuid())
  organizationId                      String            @unique
  promptStorageMode                   PromptStorageMode @default(METADATA_ONLY)
  allowAttributionTrainingTextStorage Boolean           @default(false)
  createdAt                           DateTime          @default(now())
  updatedAt                           DateTime          @updatedAt
  organization                        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model PasswordCredential {
  id                 String    @id @default(cuid())
  userId             String    @unique
  username           String    @unique
  passwordHash       String
  failedAttemptCount Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime  @default(now())
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([createdAt])
}

/// Metadata-only record of classifier prediction vs final attribution.
/// Never stores prompt or response text.
model AiAttributionDecision {
  id                      String          @id @default(cuid())
  organizationId          String
  aiRequestAuditId        String?         @unique
  sourceAppId             String
  employeeId              String?
  predictedWorkflowTypeId String?
  predictedTaskType       String?
  predictedConfidence     Float?
  modelVersion            String?
  finalWorkflowTypeId     String
  finalTaskType           String
  wasOverridden           Boolean         @default(false)
  requiredReview          Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  organization            Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiRequestAudit          AiRequestAudit? @relation(fields: [aiRequestAuditId], references: [id], onDelete: SetNull)
  sourceApp               AiSourceApp     @relation(fields: [sourceAppId], references: [id], onDelete: Cascade)
  employee                Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  predictedWorkflowType   WorkflowType?   @relation("PredictedWorkflow", fields: [predictedWorkflowTypeId], references: [id], onDelete: SetNull)
  finalWorkflowType       WorkflowType    @relation("FinalWorkflow", fields: [finalWorkflowTypeId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, wasOverridden])
  @@index([organizationId, modelVersion])
  @@index([sourceAppId])
}

model AttributionTrainingExample {
  id                  String       @id @default(cuid())
  organizationId      String
  encryptedText       String
  finalWorkflowTypeId String
  finalTaskType       String
  approved            Boolean      @default(false)
  source              String       @default("user_consent")
  consentCapturedAt   DateTime
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finalWorkflowType   WorkflowType @relation(fields: [finalWorkflowTypeId], references: [id], onDelete: Restrict)

  @@index([organizationId, approved, deletedAt])
  @@index([organizationId, createdAt])
}

model AttributionModelVersion {
  id             String        @id @default(cuid())
  organizationId String?
  version        String
  checksum       String
  macroF1        Float?
  top2Accuracy   Float?
  isActive       Boolean       @default(false)
  evaluationJson Json?
  trainedAt      DateTime      @default(now())
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, version])
  @@index([organizationId, isActive])
  @@index([createdAt])
}

model AiRequestAudit {
  id                       String                 @id @default(cuid())
  organizationId           String
  userId                   String?
  source                   AiRequestSource
  status                   AiRequestStatus
  externalLiteLlmRequestId String?
  slackTeamId              String?
  slackChannelId           String?
  slackUserId              String?
  slackThreadTs            String?
  slackMessageTs           String?
  clientId                 String?
  projectId                String?
  workflowTypeId           String?
  employeeId               String?
  sourceAppId              String?
  taskType                 String?
  sourceAppRequestId       String?
  promptStored             Boolean                @default(false)
  errorMessage             String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                     AppUser?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  client                   Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project                  Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workflowType             WorkflowType?          @relation(fields: [workflowTypeId], references: [id], onDelete: SetNull)
  employee                 Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sourceApp                AiSourceApp?           @relation(fields: [sourceAppId], references: [id], onDelete: SetNull)
  usageEvents              AiUsageEvent[]
  attributionDecision      AiAttributionDecision?

  @@unique([sourceAppId, sourceAppRequestId])
  @@index([organizationId])
  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([workflowTypeId])
  @@index([organizationId, employeeId])
  @@index([organizationId, sourceAppId])
  @@index([organizationId, taskType])
  @@index([sourceAppRequestId])
  @@index([status])
  @@index([createdAt])
  @@index([externalLiteLlmRequestId])
  @@index([slackTeamId, slackChannelId])
}

/// Normalized AI usage/cost facts ledger. One row per completed model call.
/// Costs are stored as integer micros (1 USD = 1,000,000 micros) to avoid
/// floating point/decimal precision issues during aggregation.
/// AiRequestAudit remains the request lifecycle/status table; this table
/// stores the measurable usage facts.
model AiUsageEvent {
  id                       String          @id @default(cuid())
  organizationId           String
  aiRequestAuditId         String?
  source                   AiRequestSource
  provider                 String
  model                    String
  promptTokens             Int             @default(0)
  completionTokens         Int             @default(0)
  totalTokens              Int             @default(0)
  inputCostMicros          BigInt          @default(0)
  outputCostMicros         BigInt          @default(0)
  totalCostMicros          BigInt          @default(0)
  latencyMs                Int?
  externalLiteLlmRequestId String?
  slackTeamId              String?
  slackChannelId           String?
  slackThreadTs            String?
  slackMessageTs           String?
  clientId                 String?
  projectId                String?
  workflowTypeId           String?
  employeeId               String?
  sourceAppId              String?
  taskType                 String?
  occurredAt               DateTime        @default(now())
  createdAt                DateTime        @default(now())
  organization             Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiRequestAudit           AiRequestAudit? @relation(fields: [aiRequestAuditId], references: [id], onDelete: SetNull)
  client                   Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project                  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workflowType             WorkflowType?   @relation(fields: [workflowTypeId], references: [id], onDelete: SetNull)
  employee                 Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sourceApp                AiSourceApp?    @relation(fields: [sourceAppId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([aiRequestAuditId])
  @@index([source])
  @@index([provider, model])
  @@index([clientId])
  @@index([projectId])
  @@index([workflowTypeId])
  @@index([organizationId, employeeId])
  @@index([organizationId, sourceAppId])
  @@index([organizationId, taskType])
  @@index([occurredAt])
  @@index([externalLiteLlmRequestId])
  @@index([slackTeamId, slackChannelId])
}

/// Durable background job queue stored in the app database.
/// Payloads must contain metadata only — never prompt or response text.
model BackgroundJob {
  id             String              @id @default(cuid())
  organizationId String?
  type           String
  status         BackgroundJobStatus @default(QUEUED)
  payloadJson    Json
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  runAfter       DateTime            @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status, runAfter])
  @@index([type])
  @@index([createdAt])
}
