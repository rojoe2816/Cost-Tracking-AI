{
  "name": "cost-tracking-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "mock-company-ai"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:mock": "npm --workspace @slate-ai/mock-company-ai run dev",
    "build": "npm run build:packages && next build && npm --workspace @slate-ai/mock-company-ai run build",
    "build:packages": "npm --workspace @slate-ai/contracts run build && npm --workspace @slate-ai/sdk run build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm --workspace @slate-ai/contracts run typecheck && npm --workspace @slate-ai/sdk run typecheck && npm --workspace @slate-ai/mock-company-ai run typecheck",
    "check:env": "node --conditions=react-server --import tsx ./scripts/check-env.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "simulate:slack": "tsx scripts/simulate-slack-event.ts",
    "source-app:key:create": "tsx scripts/create-source-app-key.ts",
    "gateway:test": "tsx scripts/test-internal-ai-gateway.ts",
    "gateway:v1:direct:smoke": "node --conditions=react-server --import tsx scripts/run-public-gateway-direct-smoke.ts",
    "two-app:integration:test": "node scripts/run-two-app-integration.mjs",
    "phase6:failure:test": "node scripts/run-phase6-failure-tests.mjs",
    "worker": "node --conditions=react-server --import tsx scripts/run-worker.ts",
    "idempotency:race": "node scripts/run-concurrent-idempotency.mjs",
    "classifier:train": "cd services/attribution-classifier && .venv/bin/python -m app.training",
    "classifier:evaluate": "cd services/attribution-classifier && .venv/bin/python -m app.evaluate",
    "classifier:test": "cd services/attribution-classifier && .venv/bin/pytest -q",
    "classifier:health": "curl -fsS http://127.0.0.1:8100/health",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "next": "^15.5.19",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.15",
    "prisma": "^6.19.3",
    "shadcn": "^4.11.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
